# 复制这个文件成 local.properties 再改。
#
# local.properties 不进版本库（见 .gitignore）—— 里面是你的地址、令牌和签名密码。
#
# ⚠️ 文件保存成 UTF-8。里面的中文（称呼）如果编码不对，会变成
#    「å ¥å ¥å」这种乱码显示在界面上，而且编译时不会报任何错。

# ── Android SDK ──────────────────────────────────────────────
# 用 Android Studio 打开的话，它会自己写这一行，可以不管。
sdk.dir=C\:\\Users\\你的用户名\\AppData\\Local\\Android\\Sdk

# ── 服务器地址与令牌 ─────────────────────────────────────────
#
# 这两项**可以留空**：留空的话 App 第一次打开会弹出设置页，
# 在界面上填就行（改地址不用重新编译，这点对使用者更友好）。
#
# 填了的话就是"编译时默认值"，装上去打开就能用。
garden.baseUrl=http://192.168.1.10:9394/api
garden.token=MUMU-H-替换成你自己的那串

# ── 称呼 ────────────────────────────────────────────────────
#
# 全部可以留空，留空就用括号里的默认值。
# 左边是"她"（用这个 App 的人），右边是"你"。
garden.herName=          # 她的昵称，显示在「我的」页顶部（默认：我）
garden.himName=          # 你的名字，气泡上的标签（默认：他）
garden.himCall=          # 她怎么称呼你（默认：他）
garden.herCall=          # 你怎么称呼她（默认：你）
garden.aiName=           # 那个陪着说话的 AI 叫什么（默认：小园）

# ── 纪念日 ──────────────────────────────────────────────────
# 在一起的第一天（yyyy-MM-dd），首页"我们在一起 N 天啦"用它。
# 留空就从今天开始算。
garden.startDate=2026-06-01

# ── 签名（可选）─────────────────────────────────────────────
#
# 想发 release 包才需要。不填的话会自动退回 debug 签名 ——
# 能装能跑，只是将来不能用同一个包名覆盖升级。
#
# 生成密钥：
#   keytool -genkey -v -keystore release.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias release
garden.storePassword=
garden.keyPassword=
garden.keyAlias=release
